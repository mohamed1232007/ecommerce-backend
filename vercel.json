{
    "version": 2,
    "functions": {
        "api/**/*.js": {
            "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm"
        },
        "server.js": {
            "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/server.js"
        }
    ]
}
